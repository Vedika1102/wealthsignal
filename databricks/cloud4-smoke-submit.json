{
  "run_name": "wealthsignal-cloud4-environment4-smoke",
  "timeout_seconds": 1200,
  "git_source": {
    "git_url": "https://github.com/Vedika1102/wealthsignal.git",
    "git_provider": "gitHub",
    "git_branch": "agent/cloud3-gold"
  },
  "tasks": [
    {
      "task_key": "environment4_compatibility_smoke",
      "spark_python_task": {
        "python_file": "services/pipeline_worker/src/wealthsignal_pipeline/cloud4_smoke.py",
        "source": "GIT"
      },
      "environment_key": "default"
    }
  ],
  "environments": [
    {
      "environment_key": "default",
      "spec": { "client": "4" }
    }
  ]
}
