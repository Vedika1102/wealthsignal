{
  "run_name": "wealthsignal-cloud2-25-manager",
  "timeout_seconds": 7200,
  "git_source": {
    "git_url": "https://github.com/Vedika1102/wealthsignal.git",
    "git_provider": "gitHub",
    "git_commit": "a0bbe52a7cdbcdc059631c13590b21562a43b183"
  },
  "tasks": [
    {
      "task_key": "bronze_to_silver_25",
      "spark_python_task": {
        "python_file": "services/pipeline_worker/src/wealthsignal_pipeline/cloud2_spark.py",
        "parameters": ["--manager-count", "25"],
        "source": "GIT"
      },
      "environment_key": "default"
    }
  ],
  "environments": [
    {
      "environment_key": "default",
      "spec": { "client": "2" }
    }
  ]
}
